# Python build/analysis tooling — the data pipeline behind the site (poll
# aggregation model, CEC raw-data parsers, live-tracking scraper). Not loaded
# by the site itself, but documented in CLAUDE.md as real, current parts of
# the project, unlike the many undocumented one-off/scratch scripts sitting
# alongside them in this directory (deliberately left untracked).
!regen3.py
!loadjs.py
!build_mayor_tc.py
!build_mayor_turnout.py
!build_council_turnout.py
!build_age_bracket.py
!build_legis_elig.py
!build_pres_turnout.py
!rebuild_ed_gj_2016.py
!poll_live2026.py
!us_gov_backtest.py
!pollster_method.json
!county_age_demo.json
!full_roster.json
!base_model_camp_pct.json

# v2 (profile + history) — tracked on the local v2-dev branch only (2026-10-22);
# main is what GitHub Pages publishes, so v2 joins main only once it has a home page.
v2/*.bak-*
v2/**/.DS_Store
# profile builders + their tests and inputs
!build_profile_*.py
!tests/
!tests/*.py
!tests/*.js
!data_cip/
!data_cip/*.json
# per-county village topology, loaded by v2/profile.html (data_vd/<cc>.js)
!data_vd/
!data_vd/*.js
# population-dot builders (prototype_popdots/*.py → v2/popdots_*)
!prototype_popdots/
!prototype_popdots/*.py

